  "cards": [
    {
      "dot": "cyan",
      "title": "Infrastructure",
      "items": [
        "Each model is its own Baseten deployment on its own GPU, reached over HTTPS or WebSocket",
        "Cloudflare runs the API and one agent per patient; Neon holds the records",
        "Models never call each other: the Worker and agents chain them"
      ]
    },
    {
      "dot": "emerald",
      "title": "Sona Pro today",
      "items": [
        "Mic: box ② transcribes; Laya picks the card",
        "Gemma writes briefs, notes, evidence; MedGemma reads X-rays and photos",
        "Answers come back as cards on screen, not speech"
      ]
    },
    {
      "dot": "amber",
      "title": "MiniCPM-o + MedGemma",
      "items": [
        "The agent sends the patient's words to MedGemma or Gemma for the medical answer",
        "MiniCPM-o speaks that answer and keeps hearing and turn-taking",
        "Box ③ is MedGemma 4B for images; text answers need Gemma 26B or a MedGemma 27B box"
      ]
    }
  ]
