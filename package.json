{
  "name": "sona-ai",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "e2e"
    ],
    "catalog": {
      "zod": "^4.5.4",
      "@types/node": "^26.4.1",
      "varlock": "1.18.0",
      "@cloudflare/workers-types": "^5.20260906.1",
      "@orpc/server": "^1.15.0",
      "@orpc/openapi": "^1.15.0",
      "@orpc/zod": "^1.15.0",
      "better-auth": "1.7.5",
      "@orpc/client": "^1.15.0",
      "@better-auth/expo": "1.7.5",
      "drizzle-orm": "1.0.0-rc.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:server": "turbo run dev:bare -F hono --",
    "db:push": "turbo run db:push -F @sona-ai/db --",
    "db:studio": "turbo run db:studio -F @sona-ai/db --",
    "db:generate": "turbo run db:generate -F @sona-ai/db --",
    "db:migrate": "turbo run db:migrate -F @sona-ai/db --",
    "deploy": "turbo run deploy -F @sona-ai/infra --",
    "destroy": "turbo run destroy -F @sona-ai/infra --",
    "env:generate": "varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./apps/care/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./apps/care/ && varlock codegen --path ./packages/db/",
    "test": "turbo run test",
    "db:seed": "turbo run db:seed -F @sona-ai/db --",
    "dev:care": "turbo run dev -F care --"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@sona-ai/config": "workspace:*",
    "@types/node": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.0",
  "patchedDependencies": {
    "expo-backdrop@0.1.1": "patches/expo-backdrop@0.1.1.patch"
  },
  "trustedDependencies": [
    "@shopify/react-native-skia"
  ]
}
