{
  "name": "med-ai",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run --filter native dev",
    "dev:all": "vp run -r dev",
    "build": "vp run -r build",
    "check-types": "vp run -r check-types",
    "check": "vp check && vp run -r check-types",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "hooks:setup": "vp config",
    "dev:native": "vp run --filter native dev",
    "dev:web": "vp run --filter web dev",
    "dev:server": "vp run --filter server dev",
    "db:push": "vp run --filter @med-ai/db db:push",
    "db:studio": "vp run --filter @med-ai/db db:studio",
    "db:generate": "vp run --filter @med-ai/db db:generate",
    "db:migrate": "vp run --filter @med-ai/db db:migrate",
    "deploy": "vp run --filter @med-ai/infra deploy",
    "destroy": "vp run --filter @med-ai/infra destroy"
  },
  "dependencies": {
    "@med-ai/env": "*",
    "dotenv": "^17.2.2",
    "zod": "^4.1.13",
    "expo": "~57.0.2",
    "react": "19.2.3",
    "react-native": "0.86.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251213.0",
    "@med-ai/config": "*",
    "@types/node": "^22.13.14",
    "rolldown": "1.1.0",
    "typescript": "^6",
    "vite-plus": "0.1.24"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.1.24",
    "vitest": "npm:@voidzero-dev/vite-plus-test@0.1.24"
  },
  "packageManager": "npm@11.7.0",
  "version": "1.0.0",
  "patchedDependencies": {
    "react-native-executorch@0.9.2": "patches/react-native-executorch@0.9.2.patch"
  },
  "trustedDependencies": [
    "llama.rn",
    "@shopify/react-native-skia"
  ]
}
