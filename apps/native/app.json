{
  "expo": {
    "name": "Sona Pro",
    "slug": "sona-ai",
    "owner": "zhiyuan-technology",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sona-ai",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.zhiyuantech.sona",
      "appleTeamId": "LTF2YZMF2D",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.sonaai"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#F5F6F8"
        }
      ],
      "expo-image",
      "expo-notifications",
      "expo-asset",
      "./plugins/with-scene-lifecycle",
      [
        "expo-camera",
        {
          "cameraPermission": "Sona uses the camera to scan paper pages, X-rays and wounds you attach to a visit or add to your library.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Sona listens while you hold or tap the orb, and while you record a consultation, to turn speech into text. Each recording is sent to your hospital's server to be transcribed, then deleted."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7cddd66f-5a00-404b-9b22-f6e1c171e072"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/7cddd66f-5a00-404b-9b22-f6e1c171e072"
    }
  }
}
