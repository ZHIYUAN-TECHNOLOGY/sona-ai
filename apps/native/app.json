{
  "expo": {
    "name": "med-ai",
    "slug": "med-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "med-ai",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Sona records the consult on-device to transcribe it. Audio never leaves the phone and is deleted when you sign.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "ai.zhiyuantech.aurio",
      "entitlements": {
        "com.apple.developer.kernel.increased-memory-limit": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.mybettertapp",
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      "react-native-audio-api",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      [
        "react-native-enriched-markdown",
        {
          "enableMath": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Aurio reads text from document photos on-device to add to the consult. Photos stay on this phone.",
          "cameraPermission": "Aurio scans documents (labs, referrals) on-device. Images stay on this phone."
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Aurio scans documents (labs, referrals) on-device. Images stay on this phone."
        }
      ],
      "./plugins/withObjcLinker",
      "./plugins/withSigning"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e9fa4ed3-143f-4684-a54a-012383fac6a4"
      }
    },
    "owner": "zhiyuan-technology"
  }
}
