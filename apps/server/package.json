{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -b ../../packages/api && tsdown",
    "check-types": "tsc -b ../../packages/api && tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "env:generate": "varlock codegen",
    "test": "bun test src"
  },
  "dependencies": {
    "@cloudflare/ai-chat": "0.12.0",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/zod": "catalog:",
    "@sona-ai/api": "workspace:*",
    "@sona-ai/auth": "workspace:*",
    "@sona-ai/db": "workspace:*",
    "@sona-ai/retrieval": "workspace:*",
    "agents": "0.24.0",
    "ai": "7.0.133",
    "better-auth": "catalog:",
    "hono": "^4.13.7",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@sona-ai/config": "workspace:*",
    "@sona-ai/infra": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3"
  }
}
