# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Cloudflare Email Service: the sender (on a domain onboarded under Email Sending) and the demo insurer's inbox.
# Leave empty to keep email off; the app still shows the insurer's review link.
# @required=false @sensitive=false
EMAIL_FROM=
# @required=false @sensitive=false
INSURER_EMAIL=

# Sona Care sign-in. Apple turns on with APPLE_CLIENT_ID (the Services ID; the secret is only for the web flow,
# a native iOS idToken is checked against the bundle id). Google turns on with both of its values.
# Phone sign-in needs nothing here: until an SMS provider is wired, codes are logged as "[sona-care otp] <phone> <code>".
# @required=false @sensitive=false
APPLE_CLIENT_ID=
# @required=false
APPLE_CLIENT_SECRET=
# Defaults to ai.zhiyuantech.sona.care
# @required=false @sensitive=false
APPLE_APP_BUNDLE_IDENTIFIER=
# @required=false @sensitive=false
GOOGLE_CLIENT_ID=
# @required=false
GOOGLE_CLIENT_SECRET=
