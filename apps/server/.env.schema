# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Cloudflare Email Service: the sender (on a domain onboarded under Email Sending) and the demo insurer's inbox.
# Leave empty to keep email off; the app still shows the insurer's review link.
# @required=false @sensitive=false
EMAIL_FROM=
# @required=false @sensitive=false
INSURER_EMAIL=

# Sona Care sign-in. Apple turns on with APPLE_CLIENT_ID (the Services ID; the secret is only for the web flow,
# a native iOS idToken is checked against the bundle id). Google turns on with both of its values.
# Phone sign-in needs nothing here: until an SMS provider is wired, codes are logged as "[sona-care otp] <phone> <code>".
# @required=false @sensitive=false
APPLE_CLIENT_ID=
# @required=false
APPLE_CLIENT_SECRET=
# Defaults to ai.zhiyuantech.sona.care
# @required=false @sensitive=false
APPLE_APP_BUNDLE_IDENTIFIER=
# @required=false @sensitive=false
GOOGLE_CLIENT_ID=
# @required=false
GOOGLE_CLIENT_SECRET=

# Staging demo only: "1" lets the seeded synthetic demo phone (DEMO_PATIENT_PHONE, Amelia's test account)
# sign in to Sona Care with a fixed code that the sign-in screen shows. No other number is affected. Off by default.
# @required=false @sensitive=false
DEMO_SIGN_IN=

# The lab system's shared secret for POST /lab/results (sent as "Authorization: Bearer <secret>"; tools/lab-feed/send.ts).
# Empty keeps the route closed: no result can arrive from outside the apps.
# @required=false @type=string(minLength=24)
LAB_FEED_SECRET=

# Baseten workspace API key: turns on the hosted models (packages/infra/baseten, docs/handoff.md#baseten-boxes).
# Empty keeps every model answer on the labelled fixtures.
# @required=false
BASETEN_API_KEY=

# Boxes that have moved to SageMaker in Malaysia (packages/infra/aws), as box=endpoint pairs:
# brain=sona-brain,voice=sona-voice, and embed=sona-embed for the library's embedder (else Workers AI). Empty keeps every box on Baseten. Needs the two AWS keys below.
# @required=false @sensitive=false
SAGEMAKER_ENDPOINTS=
# @required=false @sensitive=false
SAGEMAKER_REGION=ap-southeast-5
# An IAM identity that may only call sagemaker:InvokeEndpoint on those endpoints.
# @required=false @sensitive=false
AWS_ACCESS_KEY_ID=
# @required=false
AWS_SECRET_ACCESS_KEY=
# Only with temporary credentials (a local test: aws configure export-credentials --profile sona).
# @required=false
AWS_SESSION_TOKEN=

# Sona Care's live call on MiniCPM-o (box ④, sona-live): its WebSocket, e.g.
# wss://model-qjj01epq.api.baseten.co/environments/production/websocket. Empty keeps today's three-model call.
# @required=false @sensitive=false
SONA_LIVE_URL=

# Who writes Sona's answers on that call: "own" (box ④ itself, as before), "gemma" (Gemma writes each answer as on
# the three-model call, and box ④ only says it in Sona's voice; apps/server/src/agents/live.ts), or "router" (box ④
# answers the turns that are only talk, at its own speed, and Gemma the rest).
# @required=false @sensitive=false @type=enum(own, gemma, router)
SONA_LIVE_BRAIN=own
# With Gemma as the brain, who writes the patient down for her: "box2" (the Manglish ASR, as before) or "own" (box ④
# itself, once its judge of turns says the patient has finished: one box fewer on the call). Measured in Malaysia
# (4 Oct): slower, her voice at 5.4-8.3 s against 3.3-4.0 s with box ②, whose words were also the more exact.
# @required=false @sensitive=false @type=enum(box2, own)
SONA_LIVE_EAR=box2
