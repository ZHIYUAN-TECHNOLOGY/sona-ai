.git
.expo
.env
.env*.local
.DS_Store
*.tsbuildinfo
/dist
/build
/heidi_ui_capture
/heidi_ui_capture.zip
/heidi_ui_review.html
/docs
/demo
/plans
/apps/native/ios
/apps/native/android
